    { "id": "cb_sent_one", "when": "After Call me on one person's tile", "en": "[Name] has been told", "ur": "[نام] کو بتا دیا گیا ہے", "variants": [], "reviewed": false, "tone": "callback" },
    { "id": "cb_sent_all", "when": "After Ring everyone", "en": "Everyone has been told", "ur": "سب کو بتا دیا گیا ہے", "variants": [], "reviewed": false, "tone": "callback" },
