{
  "cli": {
    "version": ">= 25.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true
    },
    "companion": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "companion"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
