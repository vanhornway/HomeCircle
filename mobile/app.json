{
  "expo": {
    "name": "HomeCircle",
    "slug": "homecircle",
    "scheme": "homecircle",
    "version": "0.21.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "us.umair.homecircle",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "us.umair.homecircle",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#2F7D6D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "HomeCircle shares your location only with your family circle, end-to-end encrypted, about every 15 minutes or when someone asks.",
          "locationWhenInUsePermission": "HomeCircle shows you on your family's private map.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true,
          "color": "#2F7D6D",
          "sounds": [
            "./assets/sounds/chirp_robin.wav",
            "./assets/sounds/chirp_wren.wav",
            "./assets/sounds/chirp_finch.wav",
            "./assets/sounds/chirp_chickadee.wav",
            "./assets/sounds/chirp_cardinal.wav",
            "./assets/sounds/chirp_bluebird.wav",
            "./assets/sounds/chirp_canary.wav",
            "./assets/sounds/chirp_sparrow.wav",
            "./assets/sounds/chirp_lark.wav",
            "./assets/sounds/chirp_dove.wav",
            "./assets/sounds/sos_robin.wav",
            "./assets/sounds/sos_wren.wav",
            "./assets/sounds/sos_finch.wav",
            "./assets/sounds/sos_chickadee.wav",
            "./assets/sounds/sos_cardinal.wav",
            "./assets/sounds/sos_bluebird.wav",
            "./assets/sounds/sos_canary.wav",
            "./assets/sounds/sos_sparrow.wav",
            "./assets/sounds/sos_lark.wav",
            "./assets/sounds/sos_dove.wav"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HomeCircle uses the camera to scan invite QR codes and, when you choose, to take a photo for your circle’s helper.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-background-task",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (pulled in by expo-background-task) creates its Room database by reflection;\n# without these rules R8 strips it and the app crashes on launch.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.** { *; }\n"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HomeCircle lets you send a photo to your circle’s helper, only when you pick one.",
          "cameraPermission": "HomeCircle uses the camera to scan invite QR codes and, when you choose, to take a photo for your circle’s helper.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "c1728dfb-99dc-4ea1-92b4-e69ee944c7a5"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "vanhornway"
  }
}
