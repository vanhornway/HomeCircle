{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // lib/locationPolicy.ts imports its cost table as ./energyCosts.ts, so
    // its unit tests run with plain Node (type stripping).
    "allowImportingTsExtensions": true
  },
  // Unit tests run with plain Node (node --test), not part of the app.
  "exclude": ["node_modules", "**/*.test.ts"]
}
